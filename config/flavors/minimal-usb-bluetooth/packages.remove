dnsmasq
firewall4
nftables
kmod-nft-nat
kmod-nft-offload
ppp
ppp-mod-pppoe
odhcp6c
odhcpd-ipv6only
umdns
kmod-sound-core
kmod-sound-midi2
kmod-sound-midi2-usb
kmod-usb-audio
kmod-media-controller
alsa-lib
libmbedtls21
kmod-bluetooth
kmod-btusb
kmod-btmtk
luci
luci-light
luci-mod-admin-full
luci-mod-network
luci-app-firewall
luci-proto-ppp

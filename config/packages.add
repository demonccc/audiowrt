# Packages required by the AudioWRT core firmware.
#
# Hardware-specific packages are intentionally NOT listed here. OpenWrt's
# selected device profile remains responsible for board drivers and firmware.
# Optional audio engines belong in config/features.map instead of this list.

audiowrt-core
audiowrt-usb-audio
audiowrt-storage
audiowrt-extensions
luci-base
luci-theme-bootstrap
luci-app-audiowrt
uhttpd
uhttpd-mod-ubus
umdns
dnsmasq
wpad-basic-mbedtls

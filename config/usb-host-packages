# OpenWrt device-profile packages that prove USB host capability for AudioWRT.
#
# The validator only trusts packages resolved by OpenWrt for the selected
# device profile. If none of these packages is present, the build fails.

kmod-usb2
kmod-usb3
kmod-usb-dwc2
kmod-usb-dwc3
kmod-usb-ehci
kmod-usb-ohci
kmod-usb-uhci
kmod-usb-xhci-hcd

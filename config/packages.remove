# Router-oriented packages that must not be present in the AudioWRT image.
#
# Keep this list generic. Device-specific drivers and firmware belong to
# OpenWrt's device profile and must not be removed here.

firewall4
nftables
kmod-nft-nat
kmod-nft-offload
ppp
ppp-mod-pppoe
odhcpd-ipv6only
luci
luci-light
luci-mod-admin-full
luci-app-firewall
luci-proto-ppp

# AudioWRT-owned packages that genuinely require OpenWrt source dependency traversal.
#
# Packages NOT listed here are still compiled when they contain AudioWRT source
# code, but they are built with NO_DEPS=1 against the exact-release SDK staging
# area. This keeps unchanged OpenWrt libraries as official release binaries
# instead of recompiling their dependency trees.
#
# Only packages that really need upstream source dependencies built/staged may
# opt in here.

audiowrt-busybox
audiowrt-minimal-alsa
audiowrt-minimal-mbedtls
audiowrt-dropbear
librespot
audiowrt-sbc
audiowrt-bluez-libs
audiowrt-bluez
audiowrt-btctl
bluez-alsa

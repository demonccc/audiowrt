#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

uci -q get audiowrt-storage.main >/dev/null 2>&1 || uci -q set audiowrt-storage.main='storage'
uci -q set audiowrt-storage.main.enabled="$(uci -q get audiowrt-storage.main.enabled || echo 0)"
uci -q set audiowrt-storage.main.mode="$(uci -q get audiowrt-storage.main.mode || echo internal)"
uci -q commit audiowrt-storage
exit 0

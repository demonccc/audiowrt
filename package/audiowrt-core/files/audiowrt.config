config audiowrt 'main'
	option enabled '1'
	option identity_initialized '0'
	option provisioning_initialized '0'
	option provisioning '1'
	option device_name 'AudioWRT'
	option setup_ip '192.168.77.1'
	option setup_timeout '45'
	option wifi_ssid ''
	option last_error ''

config storage 'storage'
	option enabled '0'
	option mode 'internal'
	option device ''
	option uuid ''

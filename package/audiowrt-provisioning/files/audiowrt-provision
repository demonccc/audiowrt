#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu

radio="${1:-}"
ssid="${2:-}"
encryption="${3:-sae-mixed}"
key="${4:-}"
hostname="${5:-}"
admin_password="${6:-}"

[ "$(uci -q get audiowrt.main.provisioning || echo 0)" = '1' ] || exit 3
[ -n "$radio" ] || exit 2
[ -n "$ssid" ] || exit 2
[ -n "$hostname" ] || exit 2
[ "${#admin_password}" -ge 8 ] || exit 8

case "$hostname" in
	*[!A-Za-z0-9.-]*|.*|-*|*-) exit 9 ;;
esac

case "$encryption" in
	none) key='' ;;
	psk2|sae|sae-mixed)
		[ "${#key}" -ge 8 ] || {
			uci -q set audiowrt.main.last_error='Wi-Fi password must contain at least 8 characters.'
			uci -q commit audiowrt
			exit 4
		}
		;;
	*)
		uci -q set audiowrt.main.last_error='Unsupported Wi-Fi security mode.'
		uci -q commit audiowrt
		exit 5
		;;
esac

setup_radio="$(uci -q get wireless.audiowrt_setup.device || true)"
setup_ip="$(uci -q get audiowrt.main.setup_ip || echo 192.168.77.1)"
timeout="$(uci -q get audiowrt.main.setup_timeout || echo 45)"

uci -q set audiowrt.main.last_error=''
uci -q commit audiowrt

/usr/sbin/audiowrt-wifi-client connect "$radio" "$ssid" "$encryption" "$key"

elapsed=0
connected=0
while [ "$elapsed" -lt "$timeout" ]; do
	status="$(ubus call network.interface.audiowrt_wifi status 2>/dev/null || true)"
	if printf '%s\n' "$status" | grep -q '"up":[[:space:]]*true'; then
		connected=1
		break
	fi
	sleep 2
	elapsed=$((elapsed + 2))
done

if [ "$connected" -ne 1 ]; then
	/usr/sbin/audiowrt-wifi-client disconnect >/dev/null 2>&1 || true
	if [ -n "$setup_radio" ]; then
		current_name="$(uci -q get system.@system[0].hostname || echo AudioWRT)"
		/usr/sbin/audiowrt-wifi-client setup-start "$setup_radio" "$current_name" "$setup_ip" >/dev/null 2>&1 || true
	fi
	uci -q set audiowrt.main.provisioning='1'
	uci -q set audiowrt.main.last_error='Could not connect to the selected Wi-Fi network. Check the network and password.'
	uci -q commit audiowrt
	exit 7
fi

# Apply identity only after network connectivity has been confirmed.
uci -q set system.@system[0].hostname="$hostname"
uci -q commit system

# OpenWrt's BusyBox passwd accepts the two password entries from stdin. Values
# are passed as data, not evaluated by a shell, so punctuation remains intact.
if ! { printf '%s\n' "$admin_password"; sleep 1; printf '%s\n' "$admin_password"; } | /bin/busybox passwd root >/dev/null 2>&1; then
	uci -q set audiowrt.main.last_error='Could not set the administrator password.'
	uci -q commit audiowrt
	exit 10
fi

/usr/sbin/audiowrt-wifi-client setup-stop >/dev/null 2>&1 || true
/usr/sbin/audiowrt-wifi-client mdns-sync >/dev/null 2>&1 || true

uci -q set audiowrt.main.provisioning='0'
uci -q set audiowrt.main.last_error=''
uci -q commit audiowrt

[ -x /usr/sbin/audiowrt-storage ] && /usr/sbin/audiowrt-storage sync-core >/dev/null 2>&1 || true
logger -t audiowrt "Provisioning completed for $hostname on SSID $ssid"
exit 0
